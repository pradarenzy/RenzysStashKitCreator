source Border}" BorderThickness="1"/><TextBlock x:Name="MainFolderHexText" Grid.Row="1" Grid.Column="2"/><TextBlock x:Name="MainFolderFlText" Grid.Row="1" Grid.Column="3"/><TextBlock Grid.Row="2" Text="Subfolder:"/><Border x:Name="SubfolderSwatch" Grid.Row="2" Grid.Column="1" Width="18" Height="18" BorderBrush="{DynamicResource Border}" BorderThickness="1"/><TextBlock x:Name="SubfolderHexText" Grid.Row="2" Grid.Column="2"/><TextBlock x:Name="SubfolderFlText" Grid.Row="2" Grid.Column="3"/><TextBlock Grid.Row="3" Text="Deeper item:"/><Border x:Name="DeeperSwatch" Grid.Row="3" Grid.Column="1" Width="18" Height="18" BorderBrush="{DynamicResource Border}" BorderThickness="1"/><TextBlock x:Name="DeeperHexText" Grid.Row="3" Grid.Column="2"/><TextBlock x:Name="DeeperFlText" Grid.Row="3" Grid.Column="3"/></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Folder settings (staged)" FontWeight="SemiBold"/><ComboBox x:Name="FolderEditorCombo" Height="34" DisplayMemberPath="Label" SelectionChanged="FolderEditorCombo_SelectionChanged" AutomationProperties.Name="Folder to customize"/><Grid x:Name="FolderEditorPanel" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Folder name" Foreground="{DynamicResource SecondaryText}"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Parent folder" Foreground="{DynamicResource SecondaryText}"/><ComboBox x:Name="FolderParentCombo" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=DataContext}" DisplayMemberPath="Label" SelectedValuePath="StableId" SelectionChanged="FolderParentCombo_SelectionChanged"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="FL Browser IconIndex" Foreground="{DynamicResource SecondaryText}"/><WrapPanel><TextBox x:Name="FlIconIndexText" Width="86" TextChanged="FlIconIndexText_TextChanged" AutomationProperties.Name="FL Studio Browser IconIndex"/><Button Content="Confirm" Click="ConfirmIconIndex_Click" ToolTip="Confirm this Browser icon for every folder in the selected kit"/><Button x:Name="ApplyIconIndexButton" Content="Apply icons to kit" Style="{StaticResource AccentButton}" IsEnabled="False" Click="ApplyIconIndex_Click" ToolTip="Write the confirmed Browser IconIndex to every folder in this kit"/><Border x:Name="FlIconPreviewBorder" Width="40" Height="34" CornerRadius="7" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="4"><Grid><Image x:Name="FlIconPreviewImage" Width="28" Height="28" Stretch="Uniform"/><TextBlock x:Name="FlIconPreviewFallback" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border></WrapPanel><TextBlock x:Name="IconIndexStateText" Text="Type an index, then press Confirm." Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="4,0,4,2" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="HeightOfs / SortGroup" Foreground="{DynamicResource SecondaryText}"/><WrapPanel><TextBox Width="70" Text="{Binding FlHeightOffset,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/><TextBox Width="70" Text="{Binding FlSortGroup,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/></WrapPanel></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2"><TextBlock Text="Optional Browser tooltip" Foreground="{DynamicResource SecondaryText}"/><TextBox Text="{Binding FlTip,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="Previewed from FL Studio's installed Browser glyph range (U+F100 + IconIndex); unsupported numbers are rejected." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="4,4,0,0"/></StackPanel></Grid></Border></Expander>
     <Border Grid.Row="2" Background="{DynamicResource GridAlternate}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10"><TreeView x:Name="FinalKitTree" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.ItemContainerStyle><TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:FinalKitItemViewModel}" ItemsSource="{Binding Children}"><Grid Margin="2,3" Height="38"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SoundPlayButton" Grid.Column="0" Width="40" Height="34" Content="{Binding PlayGlyph}" Click="FinalPlayStop_Click" Padding="5" Margin="2" ToolTip="Play or stop this sound" AutomationProperties.Name="{Binding DisplayName,StringFormat=Play or stop {0}}"/><Border x:Name="SoundColorCell" Grid.Column="1" Width="40" Height="34" Background="{Binding TextColor,Converter={StaticResource HexColorBrush}}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="2" ToolTip="Derived deeper-item colour"/><TextBox x:Name="SoundNameBox" Grid.Column="2" Width="356" Height="34" Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" VerticalContentAlignment="Center" HorizontalAlignment="Left" GotFocus="FinalName_GotFocus" LostFocus="FinalName_LostFocus" KeyDown="FinalName_KeyDown" ToolTip="Rename; Enter commits and Escape cancels" AutomationProperties.Name="{Binding DisplayName,StringFormat=Name for {0}}"/><StackPanel x:Name="GroupLabelPanel" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Visibility="Collapsed" Margin="6,0,0,0"><Border Width="22" Height="22" Background="{Binding TextColor,Converter={StaticResource HexColorBrush}}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid><HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="SoundPlayButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="SoundColorCell" Property="Visibility" Value="Collapsed"/><Setter TargetName="SoundNameBox" Property="Visibility" Value="Collapsed"/><Setter TargetName="GroupLabelPanel" Property="Visibility" Value="Visible"/></DataTrigger></HierarchicalDataTemplate.Triggers></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></Border>
   </Grid>
   <Border x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="24"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Kit destination folder" FontWeight="SemiBold"/><TextBox x:Name="KitParentText" Width="680"/><Button Content="Browse parent folder" HorizontalAlignment="Left" Click="BrowseKitParent_Click"/><TextBlock Text="Kit name" FontWeight="SemiBold" Margin="4,14,4,0"/><TextBox x:Name="KitNameText" Width="420"/><CheckBox x:Name="MergeKitCheck" Content="Merge into this existing app-generated kit" Margin="6,16" Foreground="{DynamicResource PrimaryText}"/><Button Content="Use existing generated kit" HorizontalAlignment="Left" Click="ChooseExistingKit_Click"/><Separator Margin="0,16,0,12"/><TextBlock Text="Interface colour" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Choose one accent seed. The app automatically creates muted, readable supporting shades for the complete interface." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,8"/><WrapPanel><Border x:Name="UiAccentSwatch" Width="36" Height="34" CornerRadius="7" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="4"/><TextBox x:Name="UiAccentText" Width="112" Height="34" MaxLength="7" TextChanged="UiAccentText_TextChanged" AutomationProperties.Name="Interface accent hex"/><Button Content="Pick UI colour" Click="PickUiAccent_Click"/><Button Content="Muted rose" Click="ResetUiAccent_Click"/></WrapPanel><TextBlock x:Name="UiAccentStatus" Text="Changes preview immediately and are kept after Save settings." Foreground="{DynamicResource SecondaryText}" Margin="4,2,4,10"/><Button Content="Save settings" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/><TextBlock x:Name="SettingsResult" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="4,12,4,0"/></StackPanel></Border>
   <Border x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="24"><StackPanel><TextBlock Text="Kit creation history" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Previous builds also supply the processed-sound hash index used to skip repeat imports." Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,16"/><ComboBox x:Name="HistoryCombo" Height="38" SelectionChanged="HistoryCombo_SelectionChanged"/><WrapPanel Margin="0,10,0,0"><Button Content="Open selected kit" Style="{StaticResource AccentButton}" Click="OpenHistoryKit_Click"/><Button Content="Delete kit to Recycle Bin" Click="DeleteHistoryKit_Click"/><Button Content="Refresh" Click="RefreshHistory_Click"/></WrapPanel><TextBlock x:Name="HistoryDetails" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="4,18,4,0"/></StackPanel></Border>
